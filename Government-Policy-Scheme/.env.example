# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional backup

# Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Optional for cloud deployment
QDRANT_COLLECTION_NAME=government_schemes

# Embedding Model Configuration
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu  # Use 'cuda' for GPU
EMBEDDING_BATCH_SIZE=32

# Application Settings
APP_NAME=Government Scheme Discovery AI
APP_VERSION=0.1.0
DEBUG_MODE=True
LOG_LEVEL=INFO

# Data Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
VECTOR_DB_PATH=data/vector_db

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME=light

# Document Processing
MAX_PDF_PAGES=100
OCR_ENABLED=True
OCR_LANGUAGE=eng+hin  # English + Hindi

# Retrieval Settings
TOP_K_RESULTS=10
SIMILARITY_THRESHOLD=0.7
HYBRID_ALPHA=0.5  # Balance between vector and keyword search

# Gemini Settings
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=30

# Feature Flags
ENABLE_CHAT=True
ENABLE_FORM_FILLING=False  # Future feature
ENABLE_STATUS_TRACKING=False  # Future feature

# Database (Optional - for user profiles)
DATABASE_URL=sqlite:///./data/users.db

# Security
SECRET_KEY=your_secret_key_here
SESSION_TIMEOUT=3600

# External APIs (Future)
DIGILOCKER_API_KEY=
AADHAAR_API_KEY=
